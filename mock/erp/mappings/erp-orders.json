{
  "mappings": [
    {
      "name": "ERP order received (default)",
      "priority": 10,
      "request": { "method": "POST", "urlPath": "/api/orders" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "body": "{\"erpOrderNo\": \"ERP-{{jsonPath request.body '$.orderId'}}\", \"result\": \"RECEIVED\"}",
        "transformers": ["response-template"]
      }
    },
    {
      "name": "Scenario erp-timeout: responds after 5s (longer than read timeout)",
      "priority": 1,
      "request": {
        "method": "POST", "urlPath": "/api/orders",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.customerId == 'erp-timeout')]" }]
      },
      "response": {
        "status": 200,
        "fixedDelayMilliseconds": 5000,
        "headers": { "Content-Type": "application/json" },
        "body": "{\"erpOrderNo\": \"ERP-LATE\", \"result\": \"RECEIVED\"}"
      }
    },
    {
      "name": "Scenario erp-error: internal server error",
      "priority": 1,
      "request": {
        "method": "POST", "urlPath": "/api/orders",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.customerId == 'erp-error')]" }]
      },
      "response": {
        "status": 500,
        "headers": { "Content-Type": "application/json" },
        "body": "{\"error\": \"ERP internal error\"}"
      }
    },
    {
      "name": "Scenario erp-flaky (1st call): 503, then switches to Recovered",
      "priority": 1,
      "scenarioName": "erp-flaky",
      "requiredScenarioState": "Started",
      "newScenarioState": "Recovered",
      "request": {
        "method": "POST", "urlPath": "/api/orders",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.customerId == 'erp-flaky')]" }]
      },
      "response": {
        "status": 503,
        "headers": { "Content-Type": "application/json" },
        "body": "{\"error\": \"ERP temporarily unavailable\"}"
      }
    },
    {
      "name": "Scenario erp-flaky (after recovery): received. Used to demonstrate retry",
      "priority": 1,
      "scenarioName": "erp-flaky",
      "requiredScenarioState": "Recovered",
      "request": {
        "method": "POST", "urlPath": "/api/orders",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.customerId == 'erp-flaky')]" }]
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "body": "{\"erpOrderNo\": \"ERP-{{jsonPath request.body '$.orderId'}}\", \"result\": \"RECEIVED\"}",
        "transformers": ["response-template"]
      }
    },
    {"name": "Scenario erp-unavailable: always 503 (retried up to max attempts, then FAILED)", "priority": 1, "request": {"method": "POST", "urlPath": "/api/orders", "bodyPatterns": [{"matchesJsonPath": "$[?(@.customerId == 'erp-unavailable')]"}]}, "response": {"status": 503, "headers": {"Content-Type": "application/json"}, "body": "{\"error\": \"ERP unavailable\"}"}},
    {"name": "Scenario erp-outage call 1: 503", "priority": 1, "scenarioName": "erp-outage", "requiredScenarioState": "Started", "request": {"method": "POST", "urlPath": "/api/orders", "bodyPatterns": [{"matchesJsonPath": "$[?(@.customerId == 'erp-outage')]"}]}, "response": {"status": 503, "headers": {"Content-Type": "application/json"}, "body": "{\"error\": \"ERP maintenance\"}"}, "newScenarioState": "Down2"},
    {"name": "Scenario erp-outage call 2: 503", "priority": 1, "scenarioName": "erp-outage", "requiredScenarioState": "Down2", "request": {"method": "POST", "urlPath": "/api/orders", "bodyPatterns": [{"matchesJsonPath": "$[?(@.customerId == 'erp-outage')]"}]}, "response": {"status": 503, "headers": {"Content-Type": "application/json"}, "body": "{\"error\": \"ERP maintenance\"}"}, "newScenarioState": "Down3"},
    {"name": "Scenario erp-outage call 3: 503 (exceeds automatic retries)", "priority": 1, "scenarioName": "erp-outage", "requiredScenarioState": "Down3", "request": {"method": "POST", "urlPath": "/api/orders", "bodyPatterns": [{"matchesJsonPath": "$[?(@.customerId == 'erp-outage')]"}]}, "response": {"status": 503, "headers": {"Content-Type": "application/json"}, "body": "{\"error\": \"ERP maintenance\"}"}, "newScenarioState": "Recovered"},
    {"name": "Scenario erp-outage after recovery: received (manual retry succeeds)", "priority": 1, "scenarioName": "erp-outage", "requiredScenarioState": "Recovered", "request": {"method": "POST", "urlPath": "/api/orders", "bodyPatterns": [{"matchesJsonPath": "$[?(@.customerId == 'erp-outage')]"}]}, "response": {"status": 200, "headers": {"Content-Type": "application/json"}, "body": "{\"erpOrderNo\": \"ERP-{{jsonPath request.body '$.orderId'}}\", \"result\": \"RECEIVED\"}", "transformers": ["response-template"]}},
    {
      "name": "Scenario erp-reset: connection reset by peer",
      "priority": 1,
      "request": {
        "method": "POST", "urlPath": "/api/orders",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.customerId == 'erp-reset')]" }]
      },
      "response": { "fault": "CONNECTION_RESET_BY_PEER" }
