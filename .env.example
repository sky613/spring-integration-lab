# cp .env.example .env 후 비밀번호를 변경한다. .env는 .gitignore 대상이므로 Git에 커밋되지 않는다.
# 실제 비밀번호 예시: openssl rand -hex 16

# PostgreSQL
DB_NAME=integrationhub
DB_USERNAME=integrationhub
DB_PASSWORD=change-me
DB_PORT=5432

# Redis
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# api-gateway (호스트에서 접근하는 유일한 API 포트. core-api, mock-erp, mock-mes는 내부 네트워크 전용)
GATEWAY_PORT=8080
