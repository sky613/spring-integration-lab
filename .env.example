# cp .env.example .env 후 비밀번호를 변경한다. .env는 .gitignore 대상이므로 Git에 커밋되지 않는다.
# 실제 비밀번호 예시: openssl rand -hex 16

# PostgreSQL
DB_NAME=integrationhub
DB_USERNAME=integrationhub
DB_PASSWORD=change-me
DB_PORT=5432

# Redis
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# api-gateway (호스트에서 접근하는 유일한 API 포트. core-api, mock-erp, mock-mes는 내부 네트워크 전용)
GATEWAY_PORT=8080

# Keycloak (개발용 IAM. start-dev 모드이며 운영 설정이 아니다)
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# 개발용 테스트 사용자(user1: USER, admin1: USER+ADMIN) 비밀번호. Keycloak이 Realm을 가져올 때만 사용한다.
# core-api와 Gateway는 사용자 비밀번호를 받지 않는다 (Authorization Code + PKCE).
KC_TEST_USER_PASSWORD=change-me
KC_TEST_ADMIN_PASSWORD=change-me

# 로컬 ./gradlew :bootRun 용 JWT 검증 설정 (Docker에서는 docker-compose.yml이 지정)
OAUTH2_ISSUER_URI=http://localhost:8180/realms/integration-hub
OAUTH2_JWK_SET_URI=http://localhost:8180/realms/integration-hub/protocol/openid-connect/certs
