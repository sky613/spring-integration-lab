{
  "realm": "integration-hub",
  "displayName": "Integration Hub (DEV ONLY)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      { "name": "USER", "description": "Order read and create" },
      { "name": "ADMIN", "description": "Order status change/delete, ERP/MES sync, integration history, failed integration retry" }
    ]
  },
  "clients": [
    {
      "clientId": "integration-hub-web",
      "name": "Integration Hub Web (public client, Authorization Code + PKCE)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["http://localhost:8099/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8099/logged-out"
      },
      "protocolMappers": [
        {
          "name": "audience: integration-hub-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "integration-hub-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "user1",
      "enabled": true,
      "email": "user1@example.com",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "${KC_TEST_USER_PASSWORD}", "temporary": false }],
      "realmRoles": ["USER"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "email": "admin1@example.com",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "${KC_TEST_ADMIN_PASSWORD}", "temporary": false }],
      "realmRoles": ["USER", "ADMIN"]
    }
  ]
}
