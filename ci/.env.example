# cp ci/.env.example ci/.env 후 값을 바꾼다. ci/.env는 .gitignore 대상이다 (실제 비밀번호 예: openssl rand -hex 16).
# 개발 환경 배포용 비밀값은 별도 파일: cp .env.example ci/.env.dev (DB·Redis·Keycloak 비밀번호 변경)

# Jenkins 데이터 디렉터리 (호스트 절대 경로). 컨테이너에도 같은 경로로 마운트된다. 저장소 밖을 권장.
JENKINS_HOME_DIR=/Users/you/ci-data/jenkins_home
# 호스트 Docker 소켓의 GID (Docker Desktop: 0, Linux: getent group docker | cut -d: -f3)
DOCKER_SOCKET_GID=0

# 관리 포트 (127.0.0.1에만 바인딩)
GITEA_PORT=3000
JENKINS_PORT=8090
NEXUS_PORT=8091
NEXUS_REGISTRY_PORT=8092

JENKINS_ADMIN_USERNAME=admin
JENKINS_ADMIN_PASSWORD=change-me

# Gitea 관리자(저장소·Webhook 생성)와 Jenkins용 읽기 전용 계정
GITEA_ADMIN_USERNAME=ci-admin
GITEA_ADMIN_PASSWORD=change-me
GITEA_BOT_USERNAME=jenkins-bot
GITEA_BOT_PASSWORD=change-me

# Nexus 관리자(초기 설정)와 Jenkins 배포 전용 계정
NEXUS_ADMIN_PASSWORD=change-me
NEXUS_CI_USERNAME=jenkins-deployer
NEXUS_CI_PASSWORD=change-me
